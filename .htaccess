# Dizaynes — İHS (Apache) ayarları

DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS ve www'suz adres
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://dizaynes.com/$1 [R=301,L]

# Eski WordPress dosyalarını dışarıya kapat (404)
RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json)(/.*)?$ - [R=404,L]
RewriteRule ^(wp-[^/]*\.php|xmlrpc\.php|index\.php|readme\.html|license\.txt|wp-config[^/]*)$ - [R=404,NC,L]
RewriteCond %{QUERY_STRING} (^|&)(rest_route|p|page_id|author)= [NC]
RewriteRule ^$ - [R=404,L]

# Eski WordPress adresleri -> yeni karşılıkları (kalıcı 301)
RewriteRule ^hizmetlerimiz/?$ /#hizmetler [R=301,NE,L]
RewriteRule ^projeler/?$ /#projeler [R=301,NE,L]
RewriteRule ^iletisim/?$ /#iletisim [R=301,NE,L]
RewriteRule ^2d-kabartma-tavan-tasarimi/?$ /blog/2d-kabartma-tavan-tasarimi.html [R=301,L]
RewriteRule ^strafordan-3d-heykel-modelleme/?$ /blog/strafordan-3d-heykel-modelleme.html [R=301,L]
RewriteRule ^projelerimiz/home-design/?$ /#proje-kafe-tavan-kaplama [R=301,NE,L]
RewriteRule ^projelerimiz/([a-z0-9-]+)/?$ /#proje-$1 [R=301,NE,L]
</IfModule>

# Tarayıcı önbelleği (görseller uzun, sayfalar kısa)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

AddType image/webp .webp
AddType video/mp4 .mp4
AddType image/jpeg .jpg .jpeg
